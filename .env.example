# Produktion (docker compose) – kopieren nach .env im Projektordner und anpassen
JWT_SECRET=dein-sicherer-geheimer-schluessel
ADMIN_PASSWORD=sicheres-passwort
TZ=Europe/Berlin

# HTTPS / Let's Encrypt
DOMAIN=sauna.example.de
LETSENCRYPT_EMAIL=admin@example.de
# 1 = Let's-Encrypt-Testumgebung (keine Rate-Limits, Zertifikat nicht vertrauenswürdig)
LETSENCRYPT_STAGING=0

# Optional, Standard ist https://${DOMAIN}
# FRONTEND_URL=https://sauna.example.de
