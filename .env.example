# Live-Betrieb – kopieren nach .env (gleicher Ordner wie docker-compose.yml) und ausfüllen:
#   cp .env.example .env
# Die .env NIE ins Git einchecken.

# Domain + Let's Encrypt
DOMAIN=kropp.sauna-aufgussplan.de
LETSENCRYPT_EMAIL=
# 1 = Let's-Encrypt-Testumgebung (Zertifikat nicht vertrauenswürdig) – im Live-Betrieb 0
LETSENCRYPT_STAGING=0

# Geheimnisse – lange Zufallswerte, z. B.: openssl rand -hex 32
JWT_SECRET=
# Datenbank-Passwort: nur Buchstaben und Zahlen (wird in eine URL eingesetzt)
POSTGRES_PASSWORD=
# Passwort für admin@sauna.local, mindestens 10 Zeichen (gilt nur beim allerersten Start)
ADMIN_PASSWORD=

TZ=Europe/Berlin

# Backups (Admin-Panel → Backup). Dateien liegen auf dem Server im Ordner ./backups
# Uhrzeit des automatischen täglichen Backups (0–23, -1 = aus)
BACKUP_HOUR=3
# Automatische Backups nach so vielen Tagen löschen (manuelle bleiben)
BACKUP_KEEP_DAYS=14

# Protokoll (Admin-Panel → Protokoll): Einträge nach so vielen Tagen löschen (0 = nie)
AUDIT_LOG_DAYS=365
